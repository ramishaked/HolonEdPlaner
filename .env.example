# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase (Phase 2) — exposed to the client via Vite (VITE_ prefix).
# Publishable/anon key only; RLS enforces access. Never put the service_role key here.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxx"

# SUPABASE_SERVICE_ROLE_KEY: server-side ONLY — no VITE_ prefix, so Vite never
# bundles it into the browser. Used exclusively by /api/admin/schools, which adds,
# renames and retires schools and resets their passwords: `public.schools` is
# super_admin-only for writes and the logins live in `auth.users`, neither of which
# the anon key can reach. The key bypasses RLS entirely — the route re-verifies the
# caller's session and role on every request. Without it the school-management tab
# shows an error; everything else in the app works normally.
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."
